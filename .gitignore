# ── Node / npm ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json is committed on purpose (CI uses `npm ci`)

# ── SQLite database — contains encrypted secrets + all personal data ─────────
# NEVER commit this. It's your personal vault, lives only on your machine.
db/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ── Vault data directories — diary, conversations, files ─────────────────────
entries/
conversations/
worklogs/
files/

# ── Secrets & credentials — NEVER expose on GitHub ───────────────────────────
.env
.env.*
*.env
*.pem
*.key
*.cert
secrets.json
credentials.json
config.local.*

# ── Sync output / temp files ──────────────────────────────────────────────────
*.log
/tmp/
sync-output/
.sync-state/

# MCP Publisher binary
mcp-publisher.exe
mcp-publisher.tar.gz

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Generated by `node setup-windows.mjs` (contains local absolute paths) ─────
run-sync-silent.vbs

# ── Test data / scratch files ─────────────────────────────────────────────────
*.test-output.*
coverage/
